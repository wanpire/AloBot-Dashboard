# One of: local | test | staging | production. REQUIRED, no default -
# the process refuses to start without it (see app/core/config.py).
ENV_NAME=local

# This project's own Postgres. Inside docker compose the hostname is
# `postgres` (this project's own db container, not AloBot's).
DATABASE_URL=postgresql+asyncpg://dashboard:dashboard@postgres:5432/dashboard
DASHBOARD_DB_PASSWORD=dashboard

# AloBot's database through a READ-ONLY role. Leave blank until you have
# a COPY of AloBot's database to point at (make copy-alobot-db, Phase 2).
# Production is only allowed here in the final integration phase.
ALOBOT_DATABASE_URL=

# Stays false until the final integration phase. The DB role is the real
# guard; this flag lets the UI label screens read-only honestly.
ALOBOT_DB_WRITES_ENABLED=false

# openssl rand -hex 32
SESSION_SECRET=

LOG_LEVEL=INFO
